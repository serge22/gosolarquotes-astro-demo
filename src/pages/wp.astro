---
import Layout from '../layouts/Layout.astro';

const res = await fetch('https://gosolarquotes.com.au/wp-json/wp/v2/pages/46226');
const post = await res.json();
---
<Layout title={post.title.rendered}>
    <Fragment slot="head">
        <link rel="stylesheet" href="https://gosolarquotes.com.au/wp-content/plugins/elementor/assets/css/frontend.min.css" />
        <link rel="stylesheet" href="https://gosolarquotes.com.au/wp-content/plugins/elementor/assets/lib/eicons/css/elementor-icons.min.css" />
        <link rel="stylesheet" href="https://gosolarquotes.com.au/wp-content/plugins/elementor/assets/lib/swiper/v8/css/swiper.min.css" />
        <link rel="stylesheet" href="https://gosolarquotes.com.au/wp-content/plugins/elementor/assets/css/conditionals/e-swiper.min.css" />
        <link rel="stylesheet" href="https://gosolarquotes.com.au/wp-content/uploads/elementor/css/post-46226.css" />
    </Fragment>
    <Fragment set:html={post.content.rendered} />
    <script is:inline src="https://gosolarquotes.com.au/wp-content/plugins/elementor/assets/lib/swiper/v8/swiper.min.js"></script>
    <script is:inline>
        document.querySelectorAll('.elementor-widget-n-carousel[data-settings]').forEach((widget) => {
            const swiperEl = widget.querySelector('.swiper');
            if (!swiperEl || swiperEl.swiper) return;

            const settings = JSON.parse(widget.dataset.settings);
            const slidesToShow = Number(settings.slides_to_show) || 1;

            new Swiper(swiperEl, {
                slidesPerView: slidesToShow,
                spaceBetween: Number(settings.image_spacing_custom?.size) || 0,
                speed: Number(settings.speed) || 500,
                navigation: {
                    nextEl: widget.querySelector('.elementor-swiper-button-next'),
                    prevEl: widget.querySelector('.elementor-swiper-button-prev'),
                },
                breakpoints: {
                    0: { slidesPerView: Number(settings.slides_to_show_mobile) || 1 },
                    768: { slidesPerView: Number(settings.slides_to_show_tablet) || slidesToShow },
                    1025: { slidesPerView: slidesToShow },
                },
            });
        });
    </script>
</Layout>
