---
import { Image } from 'astro:assets';


import jobDetailsIcon from '../../assets/icons/icon-location-property-type-system-size.png';
import installerQuotesIcon from '../../assets/icons/icon-solar-companies-quotes-prices-rebate-warranties.png';
import youChooseIcon from '../../assets/icons/icon-review-compare-pick-installer.png';

const steps = [
  {
	icon: jobDetailsIcon,
	title: 'Job Details',
	text: 'Enter your property type, location and system size.',
  },
  {
	icon: installerQuotesIcon,
	title: 'Installer Quotes',
	text: 'Up to 4 vetted solar companies send quotes with prices, rebates, and warranties.',
  },
  {
	icon: youChooseIcon,
	title: 'You Choose',
	text: 'Review, compare, and pick the best installer.',
  },
];
---

<section class="how-it-works">
  <div class="how-it-works-inner">
	<h2 class="how-it-works-heading">HOW IT WORKS</h2>
	<p class="how-it-works-intro">
	  Compare quotes, claim rebates, and save on the right solar system — all in three simple steps.
	</p>

	<div class="steps-grid">
	  {steps.map((step, i) => (
		<>
		  <div class="step">
			<Image src={step.icon} alt={step.title} class="step-icon" />

			<h3 class="step-title">{step.title}</h3>
			<p class="step-text">{step.text}</p>
		  </div>

		  {i < steps.length - 1 && (
			<span class="step-arrow" aria-hidden="true">
			  ›
			</span>
		  )}
		</>
	  ))}
	</div>
  </div>
</section>

<style>
	.how-it-works {
		background-color: #f3f4f6;
		padding: 4rem 1rem;
		text-align: center;
	}

	.how-it-works-inner {
		margin: 0 auto;
		max-width: 80rem;
	}

	.how-it-works-heading {
		font-size: 1.5rem;
		font-weight: 800;
		letter-spacing: 0.025em;
		color: #111827;
	}

	.how-it-works-intro {
		margin-top: 1rem;
		color: #4b5563;
	}

	.steps-grid {
		margin-top: 3rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.5rem;
	}

	.step {
		max-width: 20rem;
		margin: 0 auto;
	}

	.step-icon {
		width: 8.25rem;
		height: 8.25rem;
		margin: 0 auto;
	}

	.step-title {
		margin-top: 1rem;
		font-weight: 700;
		font-size: 1.125rem;
		color: #111827;
	}

	.step-text {
		margin-top: 0.5rem;
		font-size: 0.875rem;
		color: #4b5563;
	}

	.step-arrow {
		display: flex;
		align-items: center;
		justify-content: center;
		color: #1f2937;
		font-size: 1.5rem;
		transform: rotate(90deg);
	}

	@media (min-width: 768px) {
		.steps-grid {
			display: grid;
			grid-template-columns: 1fr auto 1fr auto 1fr;
			align-items: flex-start;
			gap: 1rem;
		}

		.step-arrow {
			height: 8.25rem;
			transform: rotate(0deg);
		}
	}
</style>
