<script>
// This component hydrates itself on the client — no framework needed.
// Astro bundles this as a module scoped to this component, so nothing
// here leaks onto `window`; all wiring below happens via addEventListener
// instead of inline on*="" attributes.
declare const Chart: any;

const root = document.getElementById('gsq9')!;

// ── DATA ──────────────────────────────────────────────────────────────────────
const ER = 0.32;
const CO2_PER_KWH = 0.79;
const QUOTES_URL = 'https://gosolarquotes.com.au/solar-quotes/';

const ZONE_SUN: Record<number, number> = { 1: 6.0, 2: 5.2, 3: 4.8, 4: 4.2 };

const ZONE_LABEL: Record<number, string> = {
  1: 'Northern Territory / outback — 6.0 peak sun hours/day.',
  2: 'QLD / SA coast — 5.2 peak sun hours/day.',
  3: 'NSW / WA / most metro areas — 4.8 peak sun hours/day.',
  4: 'VIC / TAS / ACT — 4.2 peak sun hours/day.',
};

const ROOF: Record<string, { cap: number; hint: string }> = {
  small: { cap: 5, hint: 'A small home typically has 15–25m² of usable roof space, suiting up to a 5kW system.' },
  medium: { cap: 10, hint: 'A medium home typically has 30–40m² of usable roof space, suiting up to a 10kW system.' },
  large: { cap: 13, hint: 'A large home typically has 50m²+ of usable roof space, suiting systems up to 13kW.' },
};

const POSTCODE_ZONES: [number, number, number][] = [[0,799,3],[800,853,2],[854,854,3],[855,861,2],[862,862,3],[863,869,2],[870,879,1],[880,885,3],[886,1000,2],[1001,2355,3],[2356,2357,2],[2358,2384,3],[2385,2389,2],[2390,2395,3],[2396,2397,2],[2398,2399,3],[2400,2400,2],[2401,2404,3],[2405,2407,2],[2408,2544,3],[2545,2554,4],[2555,2627,3],[2628,2628,4],[2629,2629,3],[2630,2639,4],[2640,2816,3],[2817,2817,2],[2818,2820,3],[2821,2829,2],[2830,2830,3],[2831,2841,2],[2842,2872,3],[2873,2873,2],[2874,2877,3],[2878,2889,2],[2890,2999,3],[3000,3035,4],[3036,3038,3],[3039,3044,4],[3045,3045,3],[3046,3046,4],[3047,3049,3],[3050,3058,4],[3059,3059,3],[3060,3060,4],[3061,3064,3],[3065,3074,4],[3075,3076,3],[3077,3098,4],[3099,3099,3],[3100,3292,4],[3293,3302,3],[3303,3308,4],[3309,3319,3],[3320,3333,4],[3334,3337,3],[3338,3339,4],[3340,3758,3],[3759,3760,4],[3761,3764,3],[3765,3999,4],[4000,4416,3],[4417,4417,2],[4418,4427,3],[4428,4473,2],[4474,4476,1],[4477,4478,2],[4479,4485,1],[4486,4491,2],[4492,4492,1],[4493,4493,2],[4494,4494,3],[4495,4497,2],[4498,4719,3],[4720,4722,2],[4723,4723,3],[4724,4734,2],[4735,4736,1],[4737,4822,3],[4823,4823,2],[4824,4824,3],[4825,4827,2],[4828,4828,3],[4829,4829,1],[4830,5431,3],[5432,5450,2],[5451,5654,3],[5655,5669,2],[5670,5679,3],[5680,5699,2],[5700,5709,3],[5710,5722,2],[5723,5724,1],[5725,5730,2],[5731,5731,1],[5732,5732,2],[5733,5799,1],[5800,6043,3],[6044,6044,2],[6045,6256,3],[6257,6270,4],[6271,6316,3],[6317,6349,4],[6350,6353,3],[6354,6356,4],[6357,6394,3],[6395,6400,4],[6401,6430,3],[6431,6431,2],[6432,6433,3],[6434,6440,2],[6441,6441,1],[6442,6444,3],[6445,6459,4],[6460,6467,3],[6468,6469,2],[6470,6471,3],[6472,6472,2],[6473,6506,3],[6507,6508,2],[6509,6509,3],[6510,6536,2],[6537,6537,1],[6538,6555,2],[6556,6573,3],[6574,6602,2],[6603,6607,3],[6608,6641,2],[6642,6724,1],[6725,6750,2],[6751,6764,1],[6765,6765,2],[6766,6797,1],[6798,6799,2],[6800,6999,3],[7000,8999,4],[9000,9999,3]];

function zoneForPostcode(pc: string): number | null {
  const p = parseInt(pc, 10);
  if (Number.isNaN(p)) return null;
  for (const [lo, hi, zone] of POSTCODE_ZONES) {
	if (p >= lo && p <= hi) return zone;
  }
  return null;
}

// ── STATE ─────────────────────────────────────────────────────────────────────
type Results = {
  size: number; min: number; max: number; inv: string;
  prod: number; annprod: string; panels: number; sqm: number;
  self: number; co2: string;
};

const state = {
  bill: 400,
  zone: null as number | null,
  roof: 'medium',
  results: null as Results | null,
};

// ── ELEMENTS ──────────────────────────────────────────────────────────────────
const billRange = root.querySelector<HTMLInputElement>('#gsq9-bill-range')!;
const billVal = root.querySelector<HTMLElement>('#gsq9-bill-val')!;
const postcodeInput = root.querySelector<HTMLInputElement>('#gsq9-postcode')!;
const zoneDisplay = root.querySelector<HTMLElement>('#gsq9-zone-display')!;
const postcodeError = root.querySelector<HTMLElement>('#gsq9-postcode-error')!;
const sunHint = root.querySelector<HTMLElement>('#gsq9-sun-hint')!;
const roofSelect = root.querySelector<HTMLSelectElement>('#gsq9-roof')!;
const roofHint = root.querySelector<HTMLElement>('#gsq9-roof-hint')!;
const calculateBtn = root.querySelector<HTMLButtonElement>('#gsq9-btn')!;
const editBtn = root.querySelector<HTMLButtonElement>('#gsq9-edit-btn')!;
const inputsPanel = root.querySelector<HTMLElement>('#gsq9-inputs')!;
const ctaPanel = root.querySelector<HTMLElement>('#gsq9-cta')!;
const ctaBtn = root.querySelector<HTMLAnchorElement>('#gsq9-cta-btn')!;
const promptText = root.querySelector<HTMLElement>('#gsq9-prompt-text')!;
const tabButtons = root.querySelectorAll<HTMLButtonElement>('.gsq9-tab');
const heroLabelA = root.querySelector<HTMLElement>('#gsq9-hl-a')!;
const heroLabelB = root.querySelector<HTMLElement>('#gsq9-hl-b')!;
const heroNumA = root.querySelector<HTMLElement>('#gsq9-hn-a')!;
const heroNumB = root.querySelector<HTMLElement>('#gsq9-hn-b')!;
const panels: Record<string, HTMLElement> = {
  size: root.querySelector<HTMLElement>('#gsq9-sz')!,
  roof: root.querySelector<HTMLElement>('#gsq9-sr')!,
  output: root.querySelector<HTMLElement>('#gsq9-so')!,
};

// ── INPUT HANDLERS ────────────────────────────────────────────────────────────
function updateBill(v: string) {
  state.bill = parseInt(v, 10);
  billVal.textContent = '$' + state.bill;
}

function checkPostcode(v: string) {
  const c = v.replace(/\D/g, '');
  postcodeInput.value = c;
  if (c.length === 4) {
	const zone = zoneForPostcode(c);
	if (zone) {
	  state.zone = zone;
	  zoneDisplay.textContent = 'Zone ' + zone;
	  postcodeError.style.display = 'none';
	  sunHint.textContent = ZONE_LABEL[zone];
	  postcodeInput.classList.remove('gsq9-err');
	} else {
	  state.zone = null;
	  zoneDisplay.textContent = '';
	  postcodeError.style.display = 'block';
	  sunHint.textContent = 'Enter your postcode to find your peak sun hours.';
	}
  } else {
	state.zone = null;
	zoneDisplay.textContent = '';
	postcodeError.style.display = 'none';
	sunHint.textContent = 'Enter your postcode to find your peak sun hours.';
  }
}

function updateRoof() {
  state.roof = roofSelect.value;
  roofHint.textContent = ROOF[state.roof].hint;
}

// ── TABS ──────────────────────────────────────────────────────────────────────
function switchTab(name: string, btn: HTMLButtonElement) {
  for (const key of Object.keys(panels)) {
	panels[key].style.display = key === name ? 'block' : 'none';
  }

  // Chart.js can't size a canvas whose container was hidden (display:none)
  // when the chart was created, so force a resize now that it's visible.
  if (name === 'output' && chart) chart.resize();

  tabButtons.forEach((tab) => tab.classList.remove('gsq9-tab-on'));
  btn.classList.add('gsq9-tab-on');

  const r = state.results;
  if (!r) return;
  const heroes: Record<string, { la: string; lb: string; a: string; b: string }> = {
	size: { la: 'RECOMMENDED SYSTEM SIZE', lb: 'DAILY PRODUCTION', a: r.size + ' kW', b: r.prod + ' kWh/day' },
	roof: { la: 'PANELS REQUIRED', lb: 'ROOF SPACE NEEDED', a: r.panels + ' panels', b: '~' + r.sqm + ' m²' },
	output: { la: 'ANNUAL PRODUCTION', lb: 'SELF-SUFFICIENCY', a: r.annprod + ' kWh', b: '~' + r.self + '%' },
  };
  const h = heroes[name];
  if (!h) return;
  heroLabelA.textContent = h.la;
  heroLabelB.textContent = h.lb;
  heroNumA.textContent = h.a;
  heroNumB.textContent = h.b;
  heroNumB.className = 'gsq9-hero-num';
}

// ── CALCULATE ─────────────────────────────────────────────────────────────────
function calculate() {
  const pc = postcodeInput.value;
  if (!pc || pc.length !== 4 || !state.zone) {
	postcodeError.style.display = 'block';
	postcodeInput.classList.add('gsq9-err');
	postcodeInput.focus();
	return;
  }
  postcodeInput.classList.remove('gsq9-err');

  const sun = ZONE_SUN[state.zone] || 4.8;
  const cap = ROOF[state.roof].cap;

  // Daily usage from bill
  const dailyKwh = state.bill / ER / 91;

  // Ideal size capped by roof
  const rawSize = Math.min(dailyKwh / (sun * 0.78), cap);

  // Snap to standard sizes within cap
  const allSizes = [3, 4, 5, 6, 6.6, 7, 8, 9, 10, 12, 13];
  const sizes = allSizes.filter((s) => s <= cap);
  const recSize = sizes.reduce((prev, curr) =>
	Math.abs(curr - rawSize) < Math.abs(prev - rawSize) ? curr : prev
  );
  const idx = sizes.indexOf(recSize);
  const minSize = sizes[Math.max(0, idx - 1)];
  const maxSize = sizes[Math.min(sizes.length - 1, idx + 1)];

  const dailyProd = parseFloat((recSize * sun * 0.78).toFixed(1));
  const annualProd = Math.round(dailyProd * 365);
  const panelCount = Math.ceil((recSize * 1000) / 400);
  const sqm = Math.round(panelCount * 1.7);
  const selfPct = Math.round((Math.min(dailyProd, dailyKwh) / dailyKwh) * 100);
  const co2 = ((Math.min(dailyProd, dailyKwh) * 365 * CO2_PER_KWH) / 1000).toFixed(1);
  const invSize =
	recSize <= 6.6 ? recSize + 'kW single-phase'
	: recSize <= 10 ? recSize + 'kW single or three-phase'
	: recSize + 'kW three-phase';

  // Monthly production factors
  const isNorth = state.zone === 1 || state.zone === 2;
  const mf = isNorth
	? [1.05, 1.08, 1.02, 0.96, 0.88, 0.82, 0.85, 0.90, 0.98, 1.05, 1.08, 1.08]
	: [1.15, 1.10, 1.05, 0.95, 0.82, 0.72, 0.76, 0.84, 0.96, 1.08, 1.14, 1.18];
  const monthlyProd = mf.map((f) => parseFloat((dailyProd * f * 30.4).toFixed(0)));
  const monthlyUsage = mf.map(() => parseFloat((dailyKwh * 30.4).toFixed(0)));

  state.results = {
	size: recSize, min: minSize, max: maxSize, inv: invSize,
	prod: dailyProd, annprod: annualProd.toLocaleString('en-AU'),
	panels: panelCount, sqm,
	self: selfPct, co2,
  };

  // ── Hero (size tab default)
  heroLabelA.textContent = 'RECOMMENDED SYSTEM SIZE';
  heroLabelB.textContent = 'DAILY PRODUCTION';
  heroNumA.textContent = recSize + ' kW';
  heroNumB.textContent = dailyProd + ' kWh/day';
  heroNumB.className = 'gsq9-hero-num';

  // ── SIZE tab
  root.querySelector('#gsq9-z-size')!.textContent = recSize + ' kW';
  root.querySelector('#gsq9-z-min')!.textContent = minSize + ' kW';
  root.querySelector('#gsq9-z-max')!.textContent = maxSize + ' kW';
  root.querySelector('#gsq9-z-inv')!.textContent = invSize;

  // ── ROOF tab
  root.querySelector('#gsq9-r-panels')!.textContent = panelCount + ' panels';
  root.querySelector('#gsq9-r-sqm')!.textContent = '~' + sqm + ' m²';
  root.querySelector('#gsq9-r-shade')!.textContent = '~' + sqm + ' m² unshaded';

  // ── OUTPUT tab
  root.querySelector('#gsq9-o-daily')!.textContent = dailyProd + ' kWh/day';
  root.querySelector('#gsq9-o-annual')!.textContent = annualProd.toLocaleString('en-AU') + ' kWh/yr';
  root.querySelector('#gsq9-o-self')!.textContent = '~' + selfPct + '%';
  root.querySelector('#gsq9-o-co2')!.textContent = co2 + ' tonnes/yr';

  // ── Chart
  renderChart(monthlyProd, monthlyUsage);

  // ── Prompt text
  promptText.textContent = 'Click "Get My 3 Quotes Now" to compare quotes from top-voted local installers';
  promptText.style.color = '#555';
  promptText.style.fontStyle = 'normal';

  // ── Reset to Size tab
  panels.size.style.display = 'block';
  panels.roof.style.display = 'none';
  panels.output.style.display = 'none';
  tabButtons.forEach((tab) => tab.classList.remove('gsq9-tab-on'));
  tabButtons[0].classList.add('gsq9-tab-on');

  // ── CTA
  ctaBtn.href = QUOTES_URL + '?postcode=' + pc;

  // ── Flip left panel
  inputsPanel.style.display = 'none';
  ctaPanel.style.display = 'block';
}

// ── RESET ─────────────────────────────────────────────────────────────────────
function reset() {
  inputsPanel.style.display = 'block';
  ctaPanel.style.display = 'none';
  promptText.textContent = 'Fill in your details on the left to see your results';
  promptText.style.color = '#aaa';
  promptText.style.fontStyle = 'italic';
}

// ── CHART ─────────────────────────────────────────────────────────────────────
let chart: any = null;
function renderChart(prod: number[], usage: number[]) {
  const ctx = root.querySelector<HTMLCanvasElement>('#gsq9-chart');
  if (!ctx) return;
  if (chart) { chart.destroy(); chart = null; }
  chart = new Chart(ctx, {
	type: 'bar',
	data: {
	  labels: ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'],
	  datasets: [
		{
		  label: 'Solar production (kWh)',
		  data: prod,
		  backgroundColor: '#3E8AB9',
		  borderRadius: 2,
		  order: 2,
		},
		{
		  label: 'Your usage (kWh)',
		  data: usage,
		  type: 'line',
		  borderColor: '#f78e19',
		  backgroundColor: 'transparent',
		  borderWidth: 2,
		  pointBackgroundColor: '#f78e19',
		  pointRadius: 3,
		  tension: 0.3,
		  order: 1,
		},
	  ],
	},
	options: {
	  responsive: true,
	  maintainAspectRatio: false,
	  plugins: {
		legend: { position: 'bottom', labels: { font: { size: 11 }, boxWidth: 12, padding: 10 } },
		tooltip: { callbacks: { label: (c: any) => c.dataset.label + ': ' + c.raw + ' kWh' } },
	  },
	  scales: {
		x: { grid: { display: false }, ticks: { font: { size: 10 }, color: '#888' }, border: { display: false } },
		y: { grid: { color: 'rgba(0,0,0,0.05)' }, ticks: { font: { size: 10 }, color: '#888' }, border: { display: false } },
	  },
	},
  });
}

// ── WIRE UP ───────────────────────────────────────────────────────────────────
billRange.addEventListener('input', () => updateBill(billRange.value));
postcodeInput.addEventListener('input', () => checkPostcode(postcodeInput.value));
roofSelect.addEventListener('change', updateRoof);
calculateBtn.addEventListener('click', calculate);
editBtn.addEventListener('click', reset);
tabButtons.forEach((btn) => btn.addEventListener('click', () => switchTab(btn.dataset.tab!, btn)));

// ── INIT ──────────────────────────────────────────────────────────────────────
updateBill(billRange.value);
updateRoof();
</script>

