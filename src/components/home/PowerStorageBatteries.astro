---
---

<section class="power-storage">
  <div class="power-storage-inner">
    <div>
      <h2 class="power-storage-heading">
        Power Storage &amp; Batteries
      </h2>
      <p class="power-storage-text">
        Not just panels — batteries can change how you save. Learn the basics before you decide.
      </p>
    </div>

    <a href="/guides/battery-storage-basics" class="battery-card">
      <div class="battery-card-side">
        <div class="battery-card-side-text">
          <span class="battery-card-eyebrow">GUIDE</span>
          <span class="battery-card-side-title">
            Solar Battery <span class="battery-card-side-accent">Basics</span>
          </span>
        </div>
        <svg
          class="battery-card-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <rect x="2" y="7" width="17" height="10" rx="1.5" />
          <rect x="20" y="10" width="2" height="4" rx="0.5" fill="currentColor" stroke="none" />
          <line x1="6" y1="10" x2="6" y2="14" />
          <line x1="9" y1="10" x2="9" y2="14" />
          <line x1="12" y1="10" x2="12" y2="14" />
        </svg>
      </div>

      <div class="battery-card-body">
        <span class="battery-card-guide-label">GUIDE: 04</span>
        <h3 class="battery-card-title">Before you Add Battery Storage</h3>
        <p class="battery-card-text">
          From chemistry types to warranties, there's more to choosing a battery than capacity
          alone. Start with the basics.
        </p>
        <span class="battery-card-cta">
          Read guide
        </span>
      </div>
    </a>
  </div>
</section>

<style>
	.power-storage {
		background-color: #f4f4f4;
		padding: 4rem 1rem;
	}

	.power-storage-inner {
		margin: 0 auto;
		max-width: 64rem;
		display: grid;
		gap: 2.5rem;
		align-items: center;
	}

	.power-storage-heading {
		font-size: 1.875rem;
		font-weight: 800;
		line-height: 1.2;
		color: #111827;
	}

	.power-storage-text {
		margin-top: 1rem;
		color: #4b5563;
		max-width: 28rem;
	}

	.battery-card {
		display: flex;
		flex-direction: column;
		background-color: #ffffff;
		border-radius: 0.375rem;
		box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05);
		overflow: hidden;
		max-width: 36rem;
		transition: box-shadow 0.15s ease;
	}

	.battery-card:hover {
		box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1);
	}

	.battery-card-side {
		flex-shrink: 0;
		background-color: #1f3f6a;
		color: #ffffff;
		padding: 1rem;
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 1rem;
	}

	.battery-card-side-text {
		flex: 1;
	}

	.battery-card-eyebrow {
		font-size: 0.625rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		color: #cbd5e1;
	}

	.battery-card-side-title {
		display: block;
		font-weight: 700;
		font-size: 1.25rem;
		line-height: 1.3;
	}

	.battery-card-side-accent {
		color: #38bdf8;
	}

	.battery-card-icon {
		flex-shrink: 0;
		width: 2.25rem;
		height: 2.25rem;
		color: #ffffff;
	}

	.battery-card-body {
		padding: 1.5rem;
	}

	.battery-card-guide-label {
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		color: #6b7280;
	}

	.battery-card-title {
		margin-top: 0.5rem;
		font-size: 1.25rem;
		font-weight: 700;
		color: #111827;
	}

	.battery-card-body .battery-card-text {
		margin-top: 0.75rem;
		font-size: 0.875rem;
		color: #4b5563;
		max-width: none;
	}

	.battery-card-cta {
		margin-top: 1rem;
		display: inline-block;
		color: #0284c7;
		font-weight: 500;
	}

	.battery-card:hover .battery-card-cta {
		color: #0369a1;
	}

	@media (min-width: 640px) {
		.battery-card {
			flex-direction: row;
		}

		.battery-card-side {
			width: 10rem;
			flex-direction: column;
			align-items: stretch;
			gap: 0;
		}

		.battery-card-side-text {
			flex: none;
		}

		.battery-card-side-title {
			margin-top: 0.5rem;
		}

		.battery-card-icon {
			margin-top: auto;
		}
	}

	@media (min-width: 768px) {
		.power-storage-inner {
			grid-template-columns: repeat(2, 1fr);
		}

		.power-storage-heading {
			font-size: 2.25rem;
		}
	}
</style>
