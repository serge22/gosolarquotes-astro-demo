---
import { Image } from 'astro:assets';

import costCalcIcon from '../../assets/icons/solar-cost-calculator-icon.png';
import rebateCalcIcon from '../../assets/icons/solar-rebate-calculator-icon.png';
import sizingCalcIcon from '../../assets/icons/icon-solar-sizing-calculator.png';

const calculators = [
  {
	title: 'Solar Cost Calculator',
	href: '/tools/solar-cost-calculator',
	icon: costCalcIcon,
  },
  {
	title: 'Rebate Calculator',
	href: '/tools/stc-rebate-calculator',
	icon: rebateCalcIcon,
  },
  {
	title: 'System Size Calculator',
	href: '/tools/system-size-calculator',
	icon: sizingCalcIcon,
  },
];
---

<section class="free-calculators">
  <div class="free-calculators-inner">
	<p class="free-calculators-eyebrow">Free solar calculators</p>
	<h2 class="free-calculators-heading">
	  Work out your system size, cost and rebate
	</h2>
	<p class="free-calculators-intro">
	  Use our free tools to estimate the right system size for your home, what it will cost
	  after the government rebate, and how quickly it pays itself back.
	</p>

	<div class="calculator-list">
	  {calculators.map((calc) => (
		<a href={calc.href} class="calculator-item">
		  <Image src={calc.icon} alt="" class="calculator-icon" />

		  <span class="calculator-title">{calc.title}</span>
		</a>
	  ))}
	</div>
  </div>
</section>

<style>
	.free-calculators {
		background-color: #ffffff;
		padding: 5rem 1rem;
		text-align: center;
	}

	.free-calculators-inner {
		margin: 0 auto;
		max-width: 48rem;
	}

	.free-calculators-eyebrow {
		font-weight: 700;
		color: #0369a1;
	}

	.free-calculators-heading {
		margin-top: 0.75rem;
		font-size: 1.875rem;
		font-weight: 800;
		line-height: 1.2;
		color: #111827;
	}

	.free-calculators-intro {
		margin-top: 1.5rem;
		color: #4b5563;
		max-width: 42rem;
		margin-left: auto;
		margin-right: auto;
	}

	.calculator-list {
		margin-top: 3rem;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		column-gap: 2.5rem;
		row-gap: 2rem;
	}

	.calculator-item {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
		width: 8.25rem;
	}

	.calculator-icon {
		border-radius: 9999px;
		border: 1px solid #e5e7eb;
		transition:
			border-color 0.15s ease,
			box-shadow 0.15s ease;
	}

	.calculator-item:hover .calculator-icon {
		border-color: #d1d5db;
		box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
	}

	.calculator-title {
		font-weight: 700;
		color: #111827;
	}

	@media (min-width: 768px) {
		.free-calculators-heading {
			font-size: 3rem;
		}
	}
</style>
